/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Self-hosted faces. Files live in static/fonts and are served from this origin. */
@font-face {
  font-family: "Inter";
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("/fonts/inter-latin.woff2") format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-weight: 200 800;
  font-display: swap;
  src: url("/fonts/manrope-latin.woff2") format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

:root {
  --font-body: "Inter", "Helvetica Neue", Arial, sans-serif;
  --font-display: "Manrope", "Inter", "Helvetica Neue", Arial, sans-serif;
}

/* iOS Safe Area Utilities */
@layer utilities {
  .safe-padding-x {
    padding-left: max(1rem, var(--safe-area-inset-left));
    padding-right: max(1rem, var(--safe-area-inset-right));
  }
  
  .safe-padding-top {
    padding-top: calc(5rem + var(--safe-area-inset-top));
  }
  
  .safe-padding-bottom {
    padding-bottom: calc(3rem + var(--safe-area-inset-bottom));
  }
  
  @media (min-width: 640px) {
    .safe-padding-top {
      padding-top: calc(5.5rem + var(--safe-area-inset-top));
    }
  }
}

[data-svelte-transition] {
  transition: opacity 0.3s ease-in-out;
}

[data-svelte-transition="out"] {
  opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  :root {
    scroll-behavior: auto !important;
  }

  *,
  *::before,
  *::after {
    animation-delay: -0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    transition-delay: 0ms !important;
    scroll-behavior: auto !important;
  }

  [data-svelte-transition] {
    transition: none !important;
  }
}

.motion-reduce *,
.motion-reduce *::before,
.motion-reduce *::after {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.01ms !important;
  transition-delay: 0ms !important;
}

.motion-reduce [data-svelte-transition] {
  transition: none !important;
}