/* Global styles. Theme values were copied from src/lib/constants/designTokens.js. */
@import "tailwindcss";
@plugin "flowbite/plugin";
@custom-variant dark (&:where(.dark, .dark *));

@source "../node_modules/flowbite-svelte/dist";
@source "../node_modules/flowbite-svelte-icons/dist";

@theme {
  --font-sans: "Inter", "Helvetica Neue", Arial, sans-serif;
  --font-display: "Inter", "Helvetica Neue", Arial, sans-serif;

  --color-background: #0f1115;
  --color-surface: #15181f;
  --color-elevated: #1c2029;
  --color-overlay: rgba(10, 12, 16, 0.74);
  --color-scrim: rgba(7, 9, 12, 0.82);

  --color-text-primary: #f5f7fa;
  --color-text-secondary: #c7cbd7;
  --color-text-muted: #8d93a3;

  --color-border-subtle: #242833;
  --color-border-strong: #323845;

  --color-accent: #5cb2ff;
  --color-accent-primary: #5cb2ff;
  --color-accent-secondary: #ff8b6c;
  --color-accent-tertiary: #ffd27a;

  --color-success: #4ecf9f;
  --color-warning: #f6b65b;
  --color-danger: #ff6f7a;
  --color-focus: #5cb2ff;

  --color-primary-50: #0b1a26;
  --color-primary-100: #123048;
  --color-primary-200: #18466a;
  --color-primary-300: #1f5b8d;
  --color-primary-400: #2563a8;
  --color-primary-500: #5cb2ff;
  --color-primary-600: #3f94e0;
  --color-primary-700: #3276ba;
  --color-primary-800: #255794;
  --color-primary-900: #173a61;
  --color-primary: #5cb2ff;

  /*
    xs/sm/md/lg/xl/none are not registered on --spacing-*.
    Those names are also Tailwind's max-width and line-height utilities.
    A spacing key with the same name replaces them (max-w-none becomes 0,
    leading-none becomes line-height 0). The design steps are utilities below.
  */
  --spacing-xxl: 3.5rem;
  --spacing-xxxl: 4.5rem;
  --spacing-ratio-16-9: 56.25%;
  --spacing-ratio-9-16: 177.78%;

  --aspect-cinematic: 16 / 9;
  --aspect-portrait: 9 / 16;

  --height-1\/2-screen: 50vh;
  --height-2\/3-screen: 66vh;
  --height-1\/3-screen: 33vh;
  --height-1\/4-screen: 25vh;
  --height-1\/5-screen: 20vh;
  --height-1\/6-screen: 16.5vh;
  --height-1\/25-screen: 40vh;

  --shadow-focus: 0 0 0 2px rgba(12, 18, 27, 0.9), 0 0 0 4px rgba(92, 178, 255, 0.45);
  --shadow-surface: 0 6px 12px rgba(5, 8, 12, 0.35);
  --shadow-elevated: 0 10px 30px rgba(5, 8, 12, 0.4);
  --shadow-overlay: 0 20px 48px rgba(5, 8, 12, 0.45);

  --ring-color-focus: #5cb2ff;
  --ring-width-focus: 3px;

  --transition-duration-immediate: 75ms;
  --transition-duration-subtle: 180ms;
  --transition-duration-slow: 320ms;
  --transition-duration-deliberate: 500ms;

  --default-transition-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
  --ease-cinematic: cubic-bezier(0.33, 1, 0.68, 1);
  --ease-entrance: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-exit: cubic-bezier(0.4, 0, 0.2, 1);

  --animate-fade-soft: fade-soft 320ms cubic-bezier(0.33, 1, 0.68, 1) forwards;
  --animate-cross-dissolve: cross-dissolve 500ms cubic-bezier(0.22, 1, 0.36, 1) forwards;

  @keyframes fade-soft {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes cross-dissolve {
    0% {
      opacity: 0;
      filter: blur(4px);
    }
    40% {
      opacity: 1;
      filter: blur(0px);
    }
    100% {
      opacity: 1;
      filter: blur(0px);
    }
  }
}

/*
  The default border color has changed to `currentcolor` in Tailwind CSS v4,
  so we've added these compatibility styles to make sure everything still
  looks the same as it did with Tailwind CSS v3.

  If we ever want to remove these styles, we need to add an explicit border
  color utility to any element that depends on these defaults.
*/
@layer base {
  *,
  ::after,
  ::before,
  ::backdrop,
  ::file-selector-button {
    border-color: var(--color-gray-200, currentcolor);
  }
}

/* Design spacing. Kept off --spacing-* so they do not replace max-w-* or leading-none. */
@utility gap-xs { gap: 0.5rem; }
@utility gap-sm { gap: 0.75rem; }
@utility gap-md { gap: 1.25rem; }
@utility ml-xs { margin-left: 0.5rem; }
@utility mt-sm { margin-top: 0.75rem; }
@utility p-md { padding: 1.25rem; }
@utility pl-sm { padding-left: 0.75rem; }
@utility pl-md { padding-left: 1.25rem; }
@utility px-xs { padding-inline: 0.5rem; }
@utility px-sm { padding-inline: 0.75rem; }
@utility px-md { padding-inline: 1.25rem; }
@utility px-lg { padding-inline: 1.75rem; }
@utility py-xs { padding-block: 0.5rem; }
@utility py-sm { padding-block: 0.75rem; }

/* Self-hosted face. The file lives in static/fonts and is served from this origin. */
@font-face {
  font-family: "Inter";
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("/fonts/inter-latin.woff2") format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

:root {
  --font-body: "Inter", "Helvetica Neue", Arial, sans-serif;
  --font-display: "Inter", "Helvetica Neue", Arial, sans-serif;
}

@utility safe-padding-x {
  padding-left: max(1rem, var(--safe-area-inset-left));
  padding-right: max(1rem, var(--safe-area-inset-right));
}

@utility safe-padding-top {
  padding-top: calc(5rem + var(--safe-area-inset-top));

  @media (min-width: 640px) {
    padding-top: calc(5.5rem + var(--safe-area-inset-top));
  }
}

@utility safe-padding-bottom {
  padding-bottom: calc(3rem + var(--safe-area-inset-bottom));
}

[data-svelte-transition] {
  transition: opacity 0.3s ease-in-out;
}

[data-svelte-transition="out"] {
  opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  :root {
    scroll-behavior: auto !important;
  }

  *,
  *::before,
  *::after {
    animation-delay: -0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    transition-delay: 0ms !important;
    scroll-behavior: auto !important;
  }

  [data-svelte-transition] {
    transition: none !important;
  }
}

.motion-reduce *,
.motion-reduce *::before,
.motion-reduce *::after {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.01ms !important;
  transition-delay: 0ms !important;
}

.motion-reduce [data-svelte-transition] {
  transition: none !important;
}
