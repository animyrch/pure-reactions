# Firebase Configuration
PUBLIC_FIREBASE_COLLECTION_REACTION_BINOMES=reactions-local
PUBLIC_FIREBASE_COLLECTION_USER_DATA=userData_local
PUBLIC_FIREBASE_COLLECTION_PLAYLISTS=playlists_local
PUBLIC_FIREBASE_COLLECTION_QUEUES=queues_local
PUBLIC_FIREBASE_COLLECTION_YOUTUBE_CHANNEL_CLAIMS=youtubeChannelClaims_local

# Firebase Emulator (default for local development)
# Local auth note: signing up against the Auth emulator still requires clicking
# the verification link printed in the emulator terminal before protected actions
# like reaction creation are available.
PUBLIC_FIREBASE_USE_EMULATORS=true
PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
PUBLIC_FIRESTORE_EMULATOR_PORT=8086
PUBLIC_DATABASE_EMULATOR_HOST=127.0.0.1
PUBLIC_DATABASE_EMULATOR_PORT=9000
PUBLIC_AUTH_EMULATOR_HOST=127.0.0.1
PUBLIC_AUTH_EMULATOR_PORT=9099

# Algolia Search
# Optional for local / contributor development.
# When these are absent, the app uses a local in-memory search provider automatically.
# Required for production deployments that rely on Algolia.
# PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
# PUBLIC_ALGOLIA_SEARCH_API_KEY=your_algolia_search_key
# PUBLIC_ALGOLIA_REACTIONS_INDEX=your_index_name

# Algolia Admin (for indexing scripts only - never expose publicly)
# ALGOLIA_ADMIN_KEY=your_algolia_admin_key

# YouTube API (server-side only)
# Optional for local / contributor development.
# When absent, playlist and comment endpoints return empty results gracefully.
# Required for production deployments.
# YOUTUBE_API_KEY=your_youtube_api_key

# Public base URL (used for sitemap generation)
PUBLIC_BASE_URL=https://yourdomain.com

# Firebase Admin SDK
# Optional for normal local app usage with emulators.
# Required for deployments and certain admin scripts.
# Option A – file path (local/private runtime):
# Place your Firebase Admin SDK JSON file in the root directory
# Name it: pure-reactions-firebase-adminsdk-[something].json
# It will be automatically ignored by git
# FIREBASE_SERVICE_ACCOUNT=./pure-reactions-firebase-adminsdk-[your-key-id].json

# Option B – inline JSON string (CI / Netlify):
# Set this as a private env var in your hosting dashboard.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# Firebase client config
# Optional for normal local app usage with emulators.
# Required for real Firebase projects and deployed environments.
PUBLIC_FIREBASE_CONFIG={}
# Example real project config:
# PUBLIC_FIREBASE_CONFIG={"apiKey":"your_api_key","authDomain":"your_project_id.firebaseapp.com","projectId":"your_project_id","storageBucket":"your_project_id.appspot.com","messagingSenderId":"your_messaging_sender_id","appId":"your_app_id","measurementId":"your_measurement_id","databaseURL":"https://your_project_id-default-rtdb.your_region.firebasedatabase.app/"}