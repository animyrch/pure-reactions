# Firebase Configuration
PUBLIC_FIREBASE_COLLECTION_REACTION_BINOMES=your_collection_name
PUBLIC_FIREBASE_COLLECTION_USER_DATA=your_collection_name
PUBLIC_FIREBASE_COLLECTION_PLAYLISTS=your_collection_name
PUBLIC_FIREBASE_COLLECTION_QUEUES=your_collection_name
PUBLIC_FIREBASE_COLLECTION_YOUTUBE_CHANNEL_CLAIMS=your_collection_name

# Firebase Emulator (optional, for local development)
PUBLIC_FIREBASE_USE_EMULATORS=false
PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
PUBLIC_FIRESTORE_EMULATOR_PORT=8080

# Algolia Search
PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
PUBLIC_ALGOLIA_SEARCH_API_KEY=your_algolia_search_key
PUBLIC_ALGOLIA_REACTIONS_INDEX=your_index_name

# Algolia Admin (for indexing scripts only - never expose publicly)
ALGOLIA_ADMIN_KEY=your_algolia_admin_key

# YouTube API (server-side only)
YOUTUBE_API_KEY=your_youtube_api_key

# Public base URL (used for sitemap generation)
PUBLIC_BASE_URL=https://yourdomain.com

# Firebase Admin SDK
# Option A – file path (local development):
# Place your Firebase Admin SDK JSON file in the root directory
# Name it: pure-reactions-firebase-adminsdk-[something].json
# It will be automatically ignored by git
FIREBASE_SERVICE_ACCOUNT=./pure-reactions-firebase-adminsdk-[your-key-id].json

# Option B – inline JSON string (CI / Netlify):
# Set this as a private env var in your hosting dashboard.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

PUBLIC_FIREBASE_CONFIG={"apiKey":"your_api_key","authDomain":"your_project_id.firebaseapp.com","projectId":"your_project_id","storageBucket":"your_project_id.appspot.com","messagingSenderId":"your_messaging_sender_id","appId":"your_app_id","measurementId":"your_measurement_id","databaseURL":"https://your_project_id-default-rtdb.your_region.firebasedatabase.app/"}