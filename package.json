    "algolia:index:apply": "FIREBASE_SERVICE_ACCOUNT=./secrets/pure-reactions-cb457c74bbbf.json node scripts/algolia-index.mjs --apply",
    "approve:claim": "node scripts/approve-channel-claim.mjs",
